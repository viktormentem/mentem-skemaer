#!/bin/bash
#
# pre-push (emoji-guard-haard-merge-gate) — git pre-push-hook: gør VERA-guard #1 til en
# BLOKERENDE merge-gate for mentem-skemaer (prod-web → GitHub Pages).
#
# Født af handoff-vera-guard-1-haard-merge-gate-2026-06-15: guard #1 (test/emoji-guard.mjs)
# var et SIGNAL (rapporterede fil:linje+codepoint) men intet aborterede et push til prod-main
# paa roed guard. Et menneske kunne ignorere signalet og pushe en emoji-som-ikon-regression
# til prod-Pages alligevel. Denne hook lukker hullet: roed guard => exit 1 => push aborteret.
#
# SPEJLET PAA: release-range-guard-pre-push.sh (PsykologInvitation/MEMTEM-lanen) — samme
# moenster: pre-push-hook gated til release-ref'en (main), no-op for alt andet, install-script
# med sha live==canonical, dokumenteret positiv-kontrol (roed BLOK / ren ALLOW / non-main NO-OP).
#
# ADFAERD: ved push hvis remote-ref = main koeres "node test/emoji-guard.mjs" mod working tree.
#   - exit 0 (0 emoji-som-ikon) => push tilladt.
#   - exit != 0 (regression)    => push BLOKERET (exit 1); guardens egen fil:linje+codepoint vises.
# No-op for ALT andet end main (backup/*, feature/*, branch-sletning) — backup-pushes roeres aldrig.
#
# OVERRIDE (KVALITETS-gate, IKKE [verify-pause]-gate => INGEN env-token-override):
#   - Bevidst-beholdt emoji i renderet prosa/alert/Psykoedukation: tilfoej markoeren
#     "emoji-guard:allow: <begrundelse>" paa linjen (allerede bygget ind i guarden). Det er
#     den legitime vej rundt — ikke et override-token.
#   - "git push --no-verify" = sidste noedudgang (bevidst bypass). ALDRIG reflektorisk.
#
# git leverer pr. pushet ref een linje paa stdin: "<local-ref> <local-sha> <remote-ref> <remote-sha>".
# Args: $1=remote-navn $2=remote-url.
#
# Source-of-truth: .githooks/pre-push (git-versioneret — single-repo guard, lever med koden den
# beskytter). Deploy: test/install-emoji-guard-hook.sh => .git/hooks/pre-push (kør pr. klon).

set -u

GUARD_REF="${MENTEM_EMOJI_GUARD_REF:-refs/heads/main}"
ZERO="0000000000000000000000000000000000000000"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
GUARD="$REPO_ROOT/test/emoji-guard.mjs"
# VERA-guard #2 (16/7): synlig-copy-guard — em-dash/en-dash/anglicistisk bindestreg i det
# klienten FAKTISK ser. Wired ind her fordi en guard der kun koerer i suiten er RAADGIVENDE;
# gaten er dette hook. Samme konservative filosofi: mangler filen => BLOKER.
COPY_GUARD="$REPO_ROOT/test/copy-guard.mjs"
# VERA-guard #3 (17/8): §3l — intet licensinstrument klientvendt live uden afklaret grundlag
# (Viktor-beslutning 17/8). Samme begrundelse for at den staar HER og ikke kun i suiten:
# det kanoniske register er PROSA i et andet, gitignoreret repo og kan ikke spaerre en
# udrulning. Dette hook kan. Samme konservative filosofi: mangler filen => BLOKER.
TREL_GUARD="$REPO_ROOT/test/licens-3l-gate.mjs"

relevant=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # No-op for ALT andet end release-ref'en (backup/*, feature/*, no-upstream).
    [ "$remote_ref" = "$GUARD_REF" ] || continue
    # Branch-sletning (local-sha = nul) => intet at scanne.
    [ "$local_sha" = "$ZERO" ] && continue
    relevant=1
done

# Intet main-push i dette push => no-op (rør aldrig backup/feature-pushes).
if [ "$relevant" -eq 0 ]; then
    exit 0
fi

# Konservativ: kan guarden ikke koeres (node/fil mangler) => BLOKER (hellere stoppe end slippe
# en uchecket prod-push igennem). Mirror af range-guardens konservative fallback-filosofi.
if ! command -v node >/dev/null 2>&1; then
    echo "🛑 emoji-guard: node ikke fundet — kan ikke koere guarden mod $GUARD_REF." >&2
    echo "Installer node, ELLER (bevidst, sidste udvej): git push --no-verify." >&2
    exit 1
fi
if [ ! -f "$GUARD" ]; then
    echo "🛑 emoji-guard: $GUARD mangler — kan ikke verificere $GUARD_REF." >&2
    echo "(Bevidst bypass, sidste udvej: git push --no-verify.)" >&2
    exit 1
fi
if [ ! -f "$COPY_GUARD" ]; then
    echo "🛑 copy-guard: $COPY_GUARD mangler — kan ikke verificere $GUARD_REF." >&2
    echo "(Bevidst bypass, sidste udvej: git push --no-verify.)" >&2
    exit 1
fi
if [ ! -f "$TREL_GUARD" ]; then
    echo "🛑 licens-3l-gate: $TREL_GUARD mangler — kan ikke verificere $GUARD_REF." >&2
    echo "(Bevidst bypass, sidste udvej: git push --no-verify.)" >&2
    exit 1
fi

# VERA-guard #3: §3l. rc 3 = gatens EGET kontrolsaet svigtede ⇒ INGEN DOM ⇒ ogsaa BLOKER.
# En gate der ikke kunne maale, maa aldrig kunne forveksles med en gate der maalte groent;
# derfor faar rc 3 sin egen besked frem for at blive slaaet sammen med »§3l-brud«.
node "$TREL_GUARD"
trel_rc=$?
if [ "$trel_rc" -eq 3 ]; then
    echo "" >&2
    echo "🛑 licens-3l-gate: BLOKERET push til $GUARD_REF — gatens EGET kontrolsaet svigtede (rc 3)." >&2
    echo "Der er IKKE afgivet nogen dom om §3l. Ret gaten foer du pusher." >&2
    exit 1
elif [ "$trel_rc" -ne 0 ]; then
    echo "" >&2
    echo "🛑 licens-3l-gate: BLOKERET push til $GUARD_REF — §3l-brud (se ovenfor)." >&2
    echo "Viktor 17/8: »Alle licensinstrumenter skal vaere helt afklaret foer de kommer live" >&2
    echo "der er klientvendt.« FIX: giv instrumentet form A (dokumenteret gratis/open source," >&2
    echo "med kilde og dato) ELLER form B (hver betingelse som en raekke med status opfyldt)" >&2
    echo "i INSTRUMENT_LICENS — eller fjern det fra OFFENTLIGT_KLAR." >&2
    echo "(Sidste noedudgang, ALDRIG reflektorisk: git push --no-verify.)" >&2
    exit 1
fi

# VERA-guard #2 FOERST: sprog i synlig klient-copy. Guarden printer selv fil:linje + fund +
# forslag + hvorfor paa stderr ved roed, og FEJLER ogsaa hvis en fil ikke kan parses
# (ingen silent caps: en guard der tavst ikke tjekker er vaerre end ingen guard).
if ! node "$COPY_GUARD"; then
    echo "" >&2
    echo "🛑 copy-guard: BLOKERET push til $GUARD_REF — sprog-regression i SYNLIG klient-copy (se ovenfor)." >&2
    echo "FIX: skriv sammensatte ord i ET ord (nudansk-direktiv 27/6), erstat em-/en-dash med" >&2
    echo "komma/punktum/kolon/parentes — ELLER, hvis bevidst og korrekt, 'nudansk-guard:allow: <begrundelse>'" >&2
    echo "paa linjen (begrundelse PAAKRAEVET)." >&2
    echo "(Sidste noedudgang, ALDRIG reflektorisk: git push --no-verify.)" >&2
    exit 1
fi

# Koer guarden mod working tree. Ved ren tree (clean-tree-foer-push-SOP) == HEAD der pushes.
# Guarden printer selv "emoji-guard ✗ — … fil:linje  glyf (U+codepoint)" paa stderr ved roed.
if node "$GUARD"; then
    echo "✅ emoji-guard: 0 emoji-som-ikon — push til $GUARD_REF tilladt."
    exit 0
fi

echo "" >&2
echo "🛑 emoji-guard: BLOKERET push til $GUARD_REF — emoji-som-ikon-regression (se fil:linje+codepoint ovenfor)." >&2
echo "FIX: erstat med eget house-style-SVG-ikon (aria-hidden=\"true\"), ELLER — hvis bevidst" >&2
echo "prosa/alert/Psykoedukation — tilfoej 'emoji-guard:allow: <begrundelse>' paa linjen." >&2
echo "(Sidste noedudgang, ALDRIG reflektorisk: git push --no-verify.)" >&2
exit 1
